{
  "name": "my-electron-app",
  "version": "1.0.0",
  "productName": "My Electron App",
  "homepage": "https://example.com",
  "companyName": "Your Company Name",
  "copyright": "Your Company Name",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "watch": "node esbuild.config.mjs --watch",
    "dev": "npm run build:dev && electron .",
    "start": "npm run build && electron . -url=http://localhost:3000",
    "pack:m1": "electron-builder --mac --arm64",
    "pack:intel": "electron-builder --macos --x64",
    "pack:win64": "electron-builder --win --x64",
    "pack:win32": "electron-builder --win --ia32",
    "pack:linux": "electron-builder --linux --x64",
    "pack:linuxarm": "electron-builder --linux --arm64",
    "grant-exec": "if [ -d 'extraResources' ]; then \n chmod -R a+x extraResources/* \n fi"
  },
  "author": "Your Company Name",
  "license": "ISC",
  "build": {
    "artifactName": "${productName}_${arch}_${version}_unsign.${ext}",
    "extraMetadata": {
      "initRegion": ""
    },
    "asar": false,
    "appId": "com.example.my-electron-app",
    "productName": "My Electron App",
    "copyright": "Your Company Name",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon",
      "build"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "./icon/app.icns",
      "extraResources": [
        {
          "from": "./extraResources/darwin_${arch}/",
          "to": "extraResources",
          "filter": [
            "*"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "./icon/app.ico",
      "extraResources": [
        {
          "from": "./extraResources/win32_${arch}/",
          "to": "extraResources",
          "filter": [
            "*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "icon": "./icon/",
      "target": [
        "deb",
        "AppImage",
        "tar.xz"
      ],
      "extraResources": [
        {
          "from": "./extraResources/linux_${arch}/",
          "to": "extraResources",
          "filter": [
            "*"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "adm-zip": "^0.5.14",
    "electron": "npm:electron@^26.6.10",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.1",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.17.21",
    "shell-env": "2.0.0"
  },
  "dependencies": {}
}
